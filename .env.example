# Copie este arquivo para ".env" e preencha o que quiser usar.

# Prefixo dos comandos (padrão: /)
PREFIX=/

# Nome/número(s) do(s) dono(s) do bot, separados por vírgula, formato 55DDDNUMERO
# Ex: 5571999999999,5571888888888
OWNER_NUMBERS=

# Nome que aparece nas figurinhas geradas (pack/author padrão)
STICKER_PACK=Meu Bot
STICKER_AUTHOR=WhatsApp Bot

# Chave gratuita da remove.bg (https://www.remove.bg/api) - usada no comando /semfundo
REMOVEBG_API_KEY=

# Token gratuito da API "A Bíblia Digital" (https://www.abibliadigital.com.br/api)
# Crie sua conta gratuita e gere um token para os comandos de bíblia funcionarem
BIBLIA_API_TOKEN=

# Chave gratuita da KLIPY (https://klipy.com/developers) - usada nos comandos /ly, /pack e /trend
# (substituiu o Tenor, que o Google desligou em 30/06/2026)
KLIPY_API_KEY=
